{
  "name": "teleuploader-workspace",
  "version": "1.12.14",
  "private": true,
  "description": "Workspace root for TeleUploader (kana migration). The app package lives in apps/api.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "moon run filedrop:dev",
    "build": "moon run filedrop:build",
    "test": "moon run filedrop:test",
    "test:unit": "moon run filedrop:test",
    "test:quarantine": "pnpm --filter filedrop run test:quarantine",
    "lint": "moon run filedrop:lint",
    "format": "pnpm --filter filedrop run format",
    "db:migrate": "moon run filedrop:db-migrate",
    "typecheck": "pnpm --filter filedrop run typecheck",
    "smoke": "bash scripts/smoke.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.6.5",
    "husky": "^9.1.7"
  }
}
